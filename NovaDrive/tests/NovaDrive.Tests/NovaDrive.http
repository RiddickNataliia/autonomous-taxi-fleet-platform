# Step 1: Get Tokens ────────────────────────────────────────────────────────

# Open in browser, login as PASSENGER, copy code:
https://dev-wcshgsensn2evwsg.us.auth0.com/authorize?response_type=code&client_id=fdT2DaRIfCV4hTvPVaBURzeyGDT0mHhf&redirect_uri=http://localhost:8080/callback&scope=openid%20profile%20email&audience=https://novadrive-api&code_challenge=Gl83nteyIR7yYwW-URq3RxAfVyACEcNsukIIuvrvHzI&code_challenge_method=S256&prompt=login

@passengerCode = GStRqMPLyy5zm4kd3BWd-6l8KV3DcXKBJbOkT_m2DH_Og

### Get passenger token
# @name passengerTokenRequest
POST https://{{auth0Domain}}/oauth/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&client_id={{clientId}}&code={{passengerCode}}&code_verifier={{code_verifier}}&redirect_uri={{baseUrl}}/callback

###
@passengerToken = {{passengerTokenRequest.response.body.access_token}}

# Open in browser, login as ADMIN, copy code:
https://dev-wcshgsensn2evwsg.us.auth0.com/authorize?response_type=code&client_id=fdT2DaRIfCV4hTvPVaBURzeyGDT0mHhf&redirect_uri=http://localhost:8080/callback&scope=openid%20profile%20email&audience=https://novadrive-api&code_challenge=Gl83nteyIR7yYwW-URq3RxAfVyACEcNsukIIuvrvHzI&code_challenge_method=S256&prompt=login

@adminCode = cuJkVoSNq2mjmwpnPLk9WzD48tDlYNAbobyMIYpLhRSJ-

### Get admin token
# @name adminTokenRequest
POST https://{{auth0Domain}}/oauth/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&client_id={{clientId}}&code={{adminCode}}&code_verifier={{code_verifier}}&redirect_uri={{baseUrl}}/callback

###
@adminToken = {{adminTokenRequest.response.body.access_token}}

# Step 2: Vehicle Setup ─────────────────────────────────────────────────────

### Register vehicle
# @name registerVehicle
POST {{baseUrl}}/api/v1/vehicles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
"vin": "3N1AB7AP4KY123456",
"licensePlate": "10-STD-567",
"modelName": "Nissan Sentra",
"yearOfManufacture": 2021,
"vehicleType": "Standard"
}

###
@vehicleId = {{registerVehicle.response.body.vehicleId}}

### Get vehicle by ID
GET {{baseUrl}}/api/v1/vehicles/{{vehicleId}}
Authorization: Bearer {{adminToken}}

###

### Get all vehicles
GET {{baseUrl}}/api/v1/vehicles/
Authorization: Bearer {{adminToken}}

###

### Provision API key
# @name provisionKey
POST {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/api-key
Authorization: Bearer {{adminToken}}

###
@vehicleApiKey = {{provisionKey.response.body.plainTextKey}}

### Update vitals — set location near Gent
PUT {{baseUrl}}/api/v1/vehicles/vitals
X-Vehicle-Id: {{vehicleId}}
X-Api-Key: {{vehicleApiKey}}
Content-Type: application/json

{
  "vehicleId": "{{vehicleId}}",
  "latitude": 51.0543,
  "longitude": 3.7174,
  "batteryPercentage": 85
}

###

### Record inspection
POST {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/inspection
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "vehicleId": "{{vehicleId}}",
  "description": "Annual safety inspection completed",
  "technicianName": "John Smith",
  "cost": 150.00,
  "nextServiceMileage": 50000
}

###

### Activate vehicle
PUT {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/activate
Authorization: Bearer {{adminToken}}

###

### Add maintenance log
POST {{baseUrl}}/api/v1/vehicles/maintenance
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "vehicleId": "{{vehicleId}}",
  "description": "Replaced brake pads",
  "technicianName": "John Smith",
  "cost": 220.00,
  "nextServiceMileage": 60000
}

###

### Get maintenance history
GET {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/maintenance
Authorization: Bearer {{adminToken}}



# Step 3: Passenger Setup ───────────────────────────────────────────────────

###

### POST /me — first login, provision profile
POST {{baseUrl}}/api/v1/passengers/me
Authorization: Bearer {{passengerToken}}

###

### GET /me — get profile
GET {{baseUrl}}/api/v1/passengers/me
Authorization: Bearer {{passengerToken}}

###

### PUT /me — update profile
PUT {{baseUrl}}/api/v1/passengers/me
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "fullName": "Jane Doe",
  "homeAddress": "123 Main Street, Brussels",
  "preferredPaymentMethod": "CreditCard"
}

###

### GET all passengers (admin)
GET {{baseUrl}}/api/v1/passengers
Authorization: Bearer {{adminToken}}

### 
@passengerId = 90194e55-3b8a-4a6f-b76e-f8e095177acf

###

### Get passenger by ID (admin)
GET {{baseUrl}}/api/v1/passengers/{{passengerId}}
Authorization: Bearer {{adminToken}}

# Step 4: Rides ─────────────────────────────────────────────────────────────

###

### Request a ride
# @name requestRide
POST {{baseUrl}}/api/v1/rides
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "departure": "Gent St-Pieters Station",
  "destination": "Gent Korenmarkt",
  "estimatedDistanceKm": 15.5,
  "passengerLatitude": 51.0543,
  "passengerLongitude": 3.7174,
  "discountCode": null,
  "preferredVehicleType": "Luxury"
}

###
@rideId = {{requestRide.response.body.rideId}}


### Get active ride
GET {{baseUrl}}/api/v1/rides/active
Authorization: Bearer {{passengerToken}}


###

### Start ride (vehicle)
PUT {{baseUrl}}/api/v1/rides/{{rideId}}/start
X-Vehicle-Id: {{simulatorVehicleId}}
X-Api-Key: {{simulatorApiKey}}

###

### Complete ride (vehicle)
PUT {{baseUrl}}/api/v1/rides/{{rideId}}/complete
X-Vehicle-Id: {{simulatorVehicleId}}
X-Api-Key: {{simulatorApiKey}}
Content-Type: application/json

{
  "actualDistanceKm": 16.2,
  "actualDurationMinutes": 25,
  "discountCode": null
}

###

### Get ride history
GET {{baseUrl}}/api/v1/rides
Authorization: Bearer {{passengerToken}}

###

### Cancel ride (passenger)
PUT {{baseUrl}}/api/v1/rides/{{rideId}}/cancel
Authorization: Bearer {{passengerToken}}

###

### Get all rides (admin)
GET {{baseUrl}}/api/v1/rides/admin/all
Authorization: Bearer {{adminToken}}

# Step 5: Payments ──────────────────────────────────────────────────────────

### Process payment for completed ride
# @name processPayment
POST {{baseUrl}}/api/v1/payments
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "rideId": "{{rideId}}",
  "paymentMethod": "CreditCard"
}

###

### Get transaction by ride
GET {{baseUrl}}/api/v1/payments/{{rideId}}
Authorization: Bearer {{passengerToken}}


# Step 6: Support Tickets ───────────────────────────────────────────────────

### Create support ticket (passenger)
# @name createTicket
POST {{baseUrl}}/api/v1/support
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "subject": "Vehicle arrived late",
  "description": "The vehicle took 20 minutes longer than estimated to arrive."
}

###
@ticketId = {{createTicket.response.body.ticketId}}

### Get my tickets (passenger)
GET {{baseUrl}}/api/v1/support/my
Authorization: Bearer {{passengerToken}}

###

### Get specific ticket
GET {{baseUrl}}/api/v1/support/{{ticketId}}
Authorization: Bearer {{adminToken}}

###

### Get all support tickets (admin)
GET {{baseUrl}}/api/v1/support
Authorization: Bearer {{adminToken}}

###

### Start work on ticket (admin)
PUT {{baseUrl}}/api/v1/support/{{ticketId}}/start
Authorization: Bearer {{adminToken}}

###

### Update priority (admin)
PUT {{baseUrl}}/api/v1/support/{{ticketId}}/priority
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "priority": "High"
}

###

### Resolve ticket (admin)
PUT {{baseUrl}}/api/v1/support/{{ticketId}}/resolve
Authorization: Bearer {{adminToken}}

# Step 7: Discount Codes ────────────────────────────────────────────────────


### Create percentage discount code (admin)
# @name createDiscount
POST {{baseUrl}}/api/v1/discounts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "code": "SUMMER22",
  "type": "Percentage",
  "value": 15.0,
  "expirationDate": "2027-01-01T00:00:00Z",
  "minimumRideValue": 10.00
}

###
@discountId = {{createDiscount.response.body.id}}

### Create flat discount code (admin)
POST {{baseUrl}}/api/v1/discounts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "code": "WELCOME9",
  "type": "Flat",
  "value": 9.00,
  "expirationDate": "2027-01-01T00:00:00Z",
  "minimumRideValue": 10.00
}

###

### Get discount code by code string
GET {{baseUrl}}/api/v1/discounts/SUMMER22
Authorization: Bearer {{adminToken}}

###

### Get all discount codes (admin)
GET {{baseUrl}}/api/v1/discounts
Authorization: Bearer {{adminToken}}

###

### Deactivate discount code (admin)
PUT {{baseUrl}}/api/v1/discounts/{{discountId}}/deactivate
Authorization: Bearer {{adminToken}}

###

### Reactivate discount code (admin)
PUT {{baseUrl}}/api/v1/discounts/{{discountId}}/activate
Authorization: Bearer {{adminToken}}

###

### Permanently delete discount code (admin)
DELETE {{baseUrl}}/api/v1/discounts/{{discountId}}
Authorization: Bearer {{adminToken}}

# Step 8: Telemetry & Diagnostics ──────────────────────────────────────────

###

### Send telemetry (vehicle)
POST {{baseUrl}}/api/v1/telemetry
X-Vehicle-Id: {{vehicleId}}
X-Api-Key: {{vehicleApiKey}}
Content-Type: application/json

{
  "latitude": 50.8503,
  "longitude": 4.3517,
  "speedKmh": 45.5,
  "batteryPercentage": 82,
  "hardwareTemperature": 38.2
}

###

### Get telemetry by vehicle (admin)
GET {{baseUrl}}/api/v1/telemetry/{{vehicleId}}?limit=10
Authorization: Bearer {{adminToken}}

###

### Report sensor diagnostic (vehicle)
POST {{baseUrl}}/api/v1/diagnostics
X-Vehicle-Id: {{vehicleId}}
X-Api-Key: {{vehicleApiKey}}
Content-Type: application/json

{
  "sensorType": "Lidar",
  "errorCode": "LIDAR-001",
  "severity": "Warning",
  "rawSensorData": "{\"signal_strength\": 0.3, \"range\": 45.2}"
}

###

### Get diagnostics by vehicle (admin)
GET {{baseUrl}}/api/v1/diagnostics/{{vehicleId}}
Authorization: Bearer {{adminToken}}

###

### Get diagnostics by severity (admin)
GET {{baseUrl}}/api/v1/diagnostics/severity/Warning
Authorization: Bearer {{adminToken}}

# Step 9: Cleanup ───────────────────────────────────────────────────────────

###

### Deactivate vehicle (admin)
PUT {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/deactivate
Authorization: Bearer {{adminToken}}

###

### Revoke API key (admin)
DELETE {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/api-key
Authorization: Bearer {{adminToken}}

# Step 10: GraphQL ──────────────────────────────────────────────────────────────
# GraphQL is used for admin dashboard queries

### GraphQL — fleet overview
POST {{baseUrl}}/graphql
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "query": "{ vehicles { id modelName licensePlate status type } }" }

###

### GraphQL — active vehicles only
POST {{baseUrl}}/graphql
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "query": "{ vehicles(status: ACTIVE) { id modelName licensePlate battery { percentage } currentLocation { latitude longitude } } }" }

###

### GraphQL — all rides
POST {{baseUrl}}/graphql
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "query": "{ rides { id departure destination status finalPrice passengerId vehicleId } }" }

###

### GraphQL — all passengers
POST {{baseUrl}}/graphql
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "query": "{ passengers { id fullName loyaltyPoints preferredPaymentMethod } }" }

###

### GraphQL — telemetry for vehicle
POST {{baseUrl}}/graphql
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "query": "{ telemetry(vehicleId: \"22b21e43-0151-4ef4-8ea6-1e37d89d5607\", limit: 5) { timestamp speed batteryPercentage gpsCoordinates { latitude longitude } } }" }