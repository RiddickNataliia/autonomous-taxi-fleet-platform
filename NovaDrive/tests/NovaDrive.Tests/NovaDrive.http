@clientId = fdT2DaRIfCV4hTvPVaBURzeyGDT0mHhf
@audience = https://novadrive-api
@code_verifier = GLwJPitfcYXDyjVLlCKg_dKc4qZe3-cxPFII7re0zzw
@code_challenge = Gl83nteyIR7yYwW-URq3RxAfVyACEcNsukIIuvrvHzI

@simulatorVehicleId = 28c8c199-b4a4-45dd-af1f-a2db32ab467d
