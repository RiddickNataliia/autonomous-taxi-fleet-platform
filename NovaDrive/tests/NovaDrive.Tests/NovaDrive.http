# ── Step 1: Get Tokens ────────────────────────────────────────────────────────

# Open in browser, login as PASSENGER, copy code:
https://dev-wcshgsensn2evwsg.us.auth0.com/authorize?response_type=code&client_id=fdT2DaRIfCV4hTvPVaBURzeyGDT0mHhf&redirect_uri=http://localhost:5154/callback&scope=openid%20profile%20email&audience=https://novadrive-api&code_challenge=Gl83nteyIR7yYwW-URq3RxAfVyACEcNsukIIuvrvHzI&code_challenge_method=S256&prompt=login

@passengerCode = PKONA_PhdRkfex0wuBoHSYAHkFV_9xZGeHPo1TejVKEXy

### Get passenger token
# @name passengerTokenRequest
POST https://{{auth0Domain}}/oauth/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&client_id={{clientId}}&code={{passengerCode}}&code_verifier={{code_verifier}}&redirect_uri={{baseUrl}}/callback

###
@passengerToken = {{passengerTokenRequest.response.body.access_token}}

# Open in browser, login as ADMIN, copy code:
https://dev-wcshgsensn2evwsg.us.auth0.com/authorize?response_type=code&client_id=fdT2DaRIfCV4hTvPVaBURzeyGDT0mHhf&redirect_uri=http://localhost:5154/callback&scope=openid%20profile%20email&audience=https://novadrive-api&code_challenge=Gl83nteyIR7yYwW-URq3RxAfVyACEcNsukIIuvrvHzI&code_challenge_method=S256&prompt=login

@adminCode = BnT0s0Na5UkwCDRWa2e9vMjclX-P72MFvFtxAaU4Axhja

### Get admin token
# @name adminTokenRequest
POST https://{{auth0Domain}}/oauth/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&client_id={{clientId}}&code={{adminCode}}&code_verifier={{code_verifier}}&redirect_uri={{baseUrl}}/callback

###
@adminToken = {{adminTokenRequest.response.body.access_token}}

# Step 2: Vehicle Setup ─────────────────────────────────────────────────────

### Register vehicle
# @name registerVehicle
POST {{baseUrl}}/api/v1/vehicles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
"vin": "2T1BURHE5JC123456",
"licensePlate": "6-STD-789",
"modelName": "Hyundai Elantra",
"yearOfManufacture": 2021,
"vehicleType": "Standard"
}

###
@vehicleId = {{registerVehicle.response.body.vehicleId}}

### Get vehicle by ID
GET {{baseUrl}}/api/v1/vehicles/{{vehicleId}}
Authorization: Bearer {{adminToken}}

###

### Get all vehicles
GET {{baseUrl}}/api/v1/vehicles/
Authorization: Bearer {{adminToken}}

###

### Provision API key
# @name provisionKey
POST {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/api-key
Authorization: Bearer {{adminToken}}

###
@vehicleApiKey = {{provisionKey.response.body.plainTextKey}}

### Update vitals — set location near Brussels
PUT {{baseUrl}}/api/v1/vehicles/vitals
X-Vehicle-Id: {{vehicleId}}
X-Api-Key: {{vehicleApiKey}}
Content-Type: application/json

{
  "vehicleId": "{{vehicleId}}",
  "latitude": 50.8503,
  "longitude": 4.3517,
  "batteryPercentage": 85
}

###

### Record inspection
POST {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/inspection
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "vehicleId": "{{vehicleId}}",
  "description": "Annual safety inspection completed",
  "technicianName": "John Smith",
  "cost": 150.00,
  "nextServiceMileage": 50000
}

###

### Activate vehicle
PUT {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/activate
Authorization: Bearer {{adminToken}}

###

### Add maintenance log
POST {{baseUrl}}/api/v1/vehicles/maintenance
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "vehicleId": "{{vehicleId}}",
  "description": "Replaced brake pads",
  "technicianName": "John Smith",
  "cost": 220.00,
  "nextServiceMileage": 60000
}

###

### Get maintenance history
GET {{baseUrl}}/api/v1/vehicles/{{vehicleId}}/maintenance
Authorization: Bearer {{adminToken}}



